[Match]
Type=ether
# Exclude virtual Ethernet interfaces
Kind=!*

[Link]
RequiredForOnline=routable

[Network]
DHCP=yes
MulticastDNS=yes

# systemd-networkd does not set per-interface-type default route metrics, so
# they are set explicitly: Ethernet must be preferred over Wi-Fi, and Wi-Fi
# over mobile broadband. Values match NetworkManager's defaults.

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
